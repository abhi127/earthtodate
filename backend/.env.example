NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Folder (relative to backend/) where the built React app lives.
# The frontend build writes into backend/public automatically.
FRONTEND_DIST=public

JWT_ACCESS_SECRET=change-me-access-secret-32chars
JWT_REFRESH_SECRET=change-me-refresh-secret-32chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

DATABASE_TYPE=sqlite
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=geosyze
SQLITE_PATH=./database.sqlite

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
MAX_TOTAL_SIZE_MB=200

TILE_SERVER_BASE_URL=https://app.earthtodate.com
TILE_SERVER_EMAIL=your-earthtodate-email
TILE_SERVER_API_KEY=your-earthtodate-api-key
